type Option a = None | Some a

class Monad (m : Type -> Type) where
  pure : forall a, a -> m a
  bind : forall a b, m a -> (a -> m b) -> m b

let optPure x = Some x
let optBind x f =
  match x with
  | None => None
  | Some x => f x

instance Monad Option := {pure = Some, bind
                                       | None, f => None
                                       | Some x, f => f x}

infixr 90 ">>=" => bind
infixr 90 ">>='" => optBind

let main : Option Int =
  pure 20 >>= fun x =>
    None >>= fun y =>
      pure 30 >>= fun z =>
        pure $ x + y + z
