-- previously this is unsound via U-Inst1. But now it's gone, this
-- gets correctly rejected.

type List a = Nil | Cons a (List a)

infixr 90 "::" => Cons
infixl 50 "++"

let rec xs ++ ys =
  match xs, ys with
  | Nil, ys => ys
  | x :: xs, ys => x :: (xs ++ ys)


-- f : List (forall a, a -> a)
-- f': List (Int -> Int)
let f  = x ++ y
and f' = y ++ x
where
  x = (1 + _) :: Nil
  y : List (forall a, a -> a)
    = (fun x => x) :: Nil


let main = do
  let (f  :: _) = f
  let (f' :: _) = f'

  -- Low-level error: Interpreter: expected Int, found true
  -- Current Frame:
  --    FVar   Value
  --      12   true
  -- f true

  -- can't unify Bool with Int
  -- f' true

  (f, f')
