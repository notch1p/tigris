abbrev Id a = a

class Functor f where
  fmap : forall a b, (a -> b) -> f a -> f b

instance Functor Id where
  fmap f = f

let main =
  let 
    x = fmap (1 + _) 2         -- emitted a dictionary for Functor (Λα. Int) instead of Functor (Λα. α).
    y = fmap (fun _ => 1) true -- previously this yields the unsound true |- Int
                               -- Both are because of the Miller-style higher-order pattern fragment 
                               -- in unification we had been using, which is unsound when mixed w/ classes.
  (x, y)