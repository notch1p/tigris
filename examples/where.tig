-- Exercises SCC-ordered let-group typing (main sees the where-bound
-- boxedAdd) and B passed to `on`.
data Boxed a = B a

infixr 30 "`on`"
infixl 50 "^"

let rec main =
  let x = 20
      y = 30
  in boxedAdd 20 30
where
  boxedAdd  = (_ ^ _) `on` B
  B x ^ B y = x + y
  f `on` g  = fun x y =>
    f (g x) (g y)
