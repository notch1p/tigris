extern println "%println" : forall a, a -> Unit
extern append "%string-append" : String -> String -> String
extern toString "%to-string" : forall a, a -> String
extern read "%read" : forall a, Unit -> a

infixl 65 "++" => append

let fact n =
  let rec go acc
    | 0 -> acc
    | m ->
      let an = acc * m
      let _ = println $ "fact " ++ toString (n - m) ++ " = " ++ toString an
      go an @@ m - 1
  in go 1 n
--   ^^^^^^ is let x = app ... in x in TCNF.
-- This form is lowered as-is in SBCL backend to
-- (let* (....
--        (|π-29| (%int- |?x₀-20| 1))
--        (|app-30| (|go-35| |n-17| |π-21| |π-29|)))
--   |app-30|)
-- SBCL is too dumb to know that the last binding can be macro_inlined
-- therefore not exposing the tail to its tailcall optimization as this pass
-- only applies to syntactic tails therefore fact still stackoverflows on large input.

postfix 50 "!" => fact

let main =
  let _ = println "Enter a number:"
  let x = read ()
  x ! -- x! is also a valid identifier. So we parenthesize it/use juxtaposition.

