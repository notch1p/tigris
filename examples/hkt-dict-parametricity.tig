type Sum a b = Inl a | Inr b

class Functor (f : Type -> Type) where
  fmap : forall a b, (a -> b) -> f a -> f b

instance forall a, Functor (Sum a) where
  fmap f
  | Inl a => Inl a
  | Inr b => Inr (f b)
  

let main =
  let a = Inl 2
  and b = Inr 1
  in ( fmap (2 * _) a
     , fmap (1 + _) b)

