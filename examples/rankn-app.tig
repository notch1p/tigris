let g x f : Int -> (forall a, a -> a) -> Int = f x

let id x = x
and apply f x = f x

let main = (prog1, prog2, prog3)
where 
  prog1 = g 1 id
  prog2 = 
    let k = g 1
    k id
  -- unannotated g's domain hides behind apply's result MV when id is checked
  -- (GHC accepts that only with Quick Look; see error/rankn-mv)
  prog3 = (apply g 1 : (forall a, a -> a) -> Int) id